# ==========================================================================
# Variables de entorno — Gastos de la casa
# Copiá este archivo a .env.local y completá los valores.
# NADA de esto se expone al frontend: todo se usa server-side.
# ==========================================================================

# --- Seguridad ---
# PIN para entrar a la app (compartido entre las dos personas).
APP_PIN=1234
# Secreto para firmar la cookie de sesión. Poné una cadena larga y aleatoria.
# Podés generar una con: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- OpenAI (lectura de tickets) ---
OPENAI_API_KEY=
# Modelo con visión. gpt-4o-mini es barato y alcanza bien.
OPENAI_MODEL=gpt-4o-mini

# --- Google Sheets (base de datos) ---
# ID de la hoja (lo sacás de la URL entre /d/ y /edit).
GOOGLE_SHEET_ID=
# Email de la service account (termina en .iam.gserviceaccount.com).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la service account. Copiá el valor completo entre comillas.
# Reemplazá los saltos de línea reales por \n si tu proveedor lo pide (Vercel lo hace).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE\n-----END PRIVATE KEY-----\n"

# ==========================================================================
# NOTA: Si NO cargás las variables de Google Sheets, la app arranca igual en
# modo desarrollo usando un almacenamiento en memoria (se pierde al reiniciar).
# Sirve para probar la UI sin conectar nada.
# ==========================================================================
